# ==========================================================
# Flutter + Firebase + GitHub .gitignore
# ==========================================================

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Logs
# =========================
*.log
*.tmp
*.temp
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# IDE Files
# =========================
.idea/
.vscode/
*.iml
*.ipr
*.iws

# =========================
# Flutter
# =========================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
.pub-cache/

build/
**/build/

coverage/

# Generated docs
doc/api/

# Generated symbol files
app.*.symbols
app.*.map.json

# =========================
# Android
# =========================
android/.gradle/
android/local.properties

android/app/debug/
android/app/profile/
android/app/release/

# Signing
*.jks
*.keystore
key.properties
android/key.properties
**/android/key.properties

# =========================
# iOS
# =========================
ios/Flutter/.last_build_id
ios/Pods/
ios/.symlinks/

# Xcode
DerivedData/

# =========================
# Environment Files
# =========================
.env
.env.*
*.env

# =========================
# Firebase
# =========================

# Firebase Emulator
.firebase/
firebase-debug.log

# Optional
google-services.json
GoogleService-Info.plist

# Firebase Functions
functions/node_modules/
functions/.runtimeconfig.json

# =========================
# Node.js
# =========================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# =========================
# Temporary Files
# =========================
*.class
*.pyc
*.swp
*.swo
*.bak
*.orig

# =========================
# Misc
# =========================
.history/
.build/
.buildlog/
.swiftpm/
.svn/
.atom/
migrate_working_dir/

# =========================
# Generated Assets
# =========================
*.apk
*.aab

# Uncomment if you don't want APKs in GitHub
# *.apk
# *.aab

# Environment
.env
.env.*

# Android signing
*.jks
*.keystore
key.properties
**/key.properties

# Local SDK path
local.properties
**/local.properties

# Firebase config
google-services.json
GoogleService-Info.plist

# Build folders
build/
**/build/
.dart_tool/